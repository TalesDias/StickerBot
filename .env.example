# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBIT_CONNECTION_URI=amqp://guest:guest@localhost:5672

# ─── WhatsApp gateway ────────────────────────────────────────────────────────
# Where Signal credentials and pre-keys are stored. Must be on local disk (or a
# Docker named volume) and outside this repo — it is rewritten constantly and a
# torn write costs a re-pair. Docker uses /data/auth.
WA_AUTH_DIR=~/.local/share/stickerbot/auth

# Number used for the headless pairing-code flow. E.164, DIGITS ONLY:
# no +, spaces, parentheses or dashes. Use a secondary number, never a primary.
WA_PAIRING_NUMBER=5511999999999

# Chats the gateway may publish from, comma separated. Baileys delivers every
# message on the account; anything outside this list is dropped at debug level.
PUBLISHED_GROUPS=120363000000000000@g.us

# Optional. Identifies the account; matters once there is more than one.
WA_ACCOUNT=default

# Media larger than this is skipped without being downloaded.
MAX_MEDIA_SIZE_KB=3000

# ─── Sticker bot ─────────────────────────────────────────────────────────────
STICKER_PACK=Figurinhas Selat®
STICKER_AUTHOR=BoBot
STICKER_QUALITY=20

# ─── Runtime ─────────────────────────────────────────────────────────────────
# Normally set by the runtime, not here: docker-compose sets it to "production",
# which switches logging from pino-pretty to raw JSON. Defaults to "development".
NODE_ENV=development

# ─── Logging ─────────────────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
